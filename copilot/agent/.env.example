# Shared secret used by `attach_and_extract` to fetch document bytes
# from `copilot_documents_serve.php` over HTTP. Must match the value
# of `COPILOT_INTERNAL_TOKEN` set on the OpenEMR container (set per
# environment in Railway; locally exported via the shell + read by
# docker-compose). When empty, document_id-mode extraction will fail
# with a clear "COPILOT_INTERNAL_TOKEN is not configured" error.
COPILOT_INTERNAL_TOKEN=generate_with_openssl_rand_hex_32

# Direct DB access — for login fail-counter reset after successful token
DB_HOST=interchange.proxy.rlwy.net
DB_PORT=49715
DB_USER=root
DB_PASSWORD=your_db_password_here
DB_NAME=openemr

# Optional — Langfuse observability
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
